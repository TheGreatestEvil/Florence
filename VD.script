local function switchTab(which)
	if which == "list" then
		listPanel.Visible = true
		colorPanel.Visible = false
		listTab.BackgroundColor3  = Color3.fromRGB(65, 25, 25)
		listTab.TextColor3        = Color3.fromRGB(255, 120, 120)
		colorTab.BackgroundColor3 = Color3.fromRGB(35, 35, 44)
		colorTab.TextColor3       = Color3.fromRGB(180, 180, 190)
	else
		listPanel.Visible = false
		colorPanel.Visible = true
		listTab.BackgroundColor3  = Color3.fromRGB(35, 35, 44)
		listTab.TextColor3        = Color3.fromRGB(180, 180, 190)
		colorTab.BackgroundColor3 = Color3.fromRGB(65, 25, 25)
		colorTab.TextColor3       = Color3.fromRGB(255, 120, 120)
	end
end

listTab.MouseButton1Click:Connect(function() switchTab("list") end)
colorTab.MouseButton1Click:Connect(function() switchTab("color") end)

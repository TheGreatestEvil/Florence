sectionLabel("OUTLINE COLOR", 9)

local function buildRGBSliders(parent, order, getColor, setColor)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 78),
		BackgroundTransparency = 1,
		LayoutOrder = order,
	}, parent)

	local labels = { "R", "G", "B" }
	local colors = {
		Color3.fromRGB(255, 70, 70),
		Color3.fromRGB(70, 220, 90),
		Color3.fromRGB(80, 140, 255),
	}
	local fillRefs, labelRefs = {}, {}

	local function syncAllLocal()
		local c = getColor()
		local comps = { c.R, c.G, c.B }
		for i = 1, 3 do
			local frac = comps[i]
			fillRefs[i].Size = UDim2.new(frac, 0, 1, 0)
			labelRefs[i].knob.Position = UDim2.new(frac, 0, 0.5, 0)
			labelRefs[i].value.Text = tostring(math.floor(frac * 255 + 0.5))
		end
		refreshAllColors()
		previewFrame.BackgroundColor3 = CONFIG.OutlineColor
		previewInner.BackgroundColor3 = CONFIG.FillColor
	end

	local function makeRow(i)
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			Position = UDim2.new(0, 0, 0, (i - 1) * 26),
			BackgroundTransparency = 1,
		}, holder)

		new("TextLabel", {
			Size = UDim2.new(0, 16, 1, 0),
			BackgroundTransparency = 1,
			Text = labels[i],
			TextColor3 = colors[i],
			Font = Enum.Font.GothamBold,
			TextSize = 12,
		}, row)

		local track = new("Frame", {
			Position = UDim2.new(0, 20, 0.5, -6),
			Size = UDim2.new(1, -60, 0, 12),
			BackgroundColor3 = Color3.fromRGB(40, 40, 50),
			BorderSizePixel = 0,
		}, row)
		new("UICorner", { CornerRadius = UDim.new(0, 6) }, track)

		local fill = new("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = colors[i],
			BorderSizePixel = 0,
		}, track)
		new("UICorner", { CornerRadius = UDim.new(0, 6) }, fill)

		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 16, 0, 16),
			BackgroundColor3 = Color3.fromRGB(240, 240, 245),
			BorderSizePixel = 0,
			ZIndex = 2,
		}, track)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
		new("UIStroke", { Color = Color3.fromRGB(15, 15, 20), Thickness = 1 }, knob)

		local valueLbl = new("TextLabel", {
			Position = UDim2.new(1, -36, 0, 0),
			Size = UDim2.new(0, 36, 1, 0),
			BackgroundTransparency = 1,
			Text = "0",
			TextColor3 = Color3.fromRGB(210, 210, 220),
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)

		local function updateFromX(x)
			local rel = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
			rel = math.clamp(rel, 0, 1)
			local v = math.floor(rel * 255 + 0.5)
			local c = getColor()
			if i == 1 then
				c = Color3.fromRGB(v, math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
			elseif i == 2 then
				c = Color3.fromRGB(math.floor(c.R * 255 + 0.5), v, math.floor(c.B * 255 + 0.5))
			else
				c = Color3.fromRGB(math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), v)
			end
			setColor(c)
			syncAllLocal()
			if _G.__syncHex then _G.__syncHex() end
		end

		local dragging = false
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				updateFromX(input.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				updateFromX(input.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		fillRefs[i]  = fill
		labelRefs[i] = { knob = knob, value = valueLbl }
	end

	for i = 1, 3 do makeRow(i) end

	return syncAllLocal
end

local syncFill    = buildRGBSliders(colorPanel, 5,
	function() return CONFIG.FillColor end,
	function(c) CONFIG.FillColor = c end)

local syncOutline = buildRGBSliders(colorPanel, 10,
	function() return CONFIG.OutlineColor end,
	function(c) CONFIG.OutlineColor = c end)

-- Hex input rows
local hexRow = new("Frame", {
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundTransparency = 1,
	LayoutOrder = 6,
}, colorPanel)
new("TextLabel", {
	Size = UDim2.new(0, 40, 1, 0),
	BackgroundTransparency = 1,
	Text = "FILL",
	TextColor3 = Color3.fromRGB(160, 160, 170),
	Font = Enum.Font.GothamBold,
	TextSize = 11,
	TextXAlignment = Enum.TextXAlignment.Left,
}, hexRow)
local fillHexBox = new("TextBox", {
	Position = UDim2.new(0, 44, 0, 0),
	Size = UDim2.new(1, -44, 1, 0),
	BackgroundColor3 = Color3.fromRGB(40, 40, 50),
	BorderSizePixel = 0,
	Text = colorToHex(CONFIG.FillColor),
	TextColor3 = Color3.fromRGB(230, 230, 235),
	PlaceholderText = "#RRGGBB",
	PlaceholderColor3 = Color3.fromRGB(120, 120, 130),
	Font = Enum.Font.Code,
	TextSize = 12,
	ClearTextOnFocus = false,
}, hexRow)
new("UICorner", { CornerRadius = UDim.new(0, 5) }, fillHexBox)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, fillHexBox)

local outlineHexRow = new("Frame", {
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundTransparency = 1,
	LayoutOrder = 11,
}, colorPanel)
new("TextLabel", {
	Size = UDim2.new(0, 40, 1, 0),
	BackgroundTransparency = 1,
	Text = "LINE",
	TextColor3 = Color3.fromRGB(160, 160, 170),
	Font = Enum.Font.GothamBold,
	TextSize = 11,
	TextXAlignment = Enum.TextXAlignment.Left,
}, outlineHexRow)
local outlineHexBox = new("TextBox", {
	Position = UDim2.new(0, 44, 0, 0),
	Size = UDim2.new(1, -44, 1, 0),
	BackgroundColor3 = Color3.fromRGB(40, 40, 50),
	BorderSizePixel = 0,
	Text = colorToHex(CONFIG.OutlineColor),
	TextColor3 = Color3.fromRGB(230, 230, 235),
	PlaceholderText = "#RRGGBB",
	PlaceholderColor3 = Color3.fromRGB(120, 120, 130),
	Font = Enum.Font.Code,
	TextSize = 12,
	ClearTextOnFocus = false,
}, outlineHexRow)
new("UICorner", { CornerRadius = UDim.new(0, 5) }, outlineHexBox)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, outlineHexBox)

fillHexBox.FocusLost:Connect(function()
	local c = hexToColor(fillHexBox.Text)
	if c then CONFIG.FillColor = c
	else fillHexBox.Text = colorToHex(CONFIG.FillColor) end
	syncFill(); refreshAllColors()
	previewInner.BackgroundColor3 = CONFIG.FillColor
end)

outlineHexBox.FocusLost:Connect(function()
	local c = hexToColor(outlineHexBox.Text)
	if c then CONFIG.OutlineColor = c
	else outlineHexBox.Text = colorToHex(CONFIG.OutlineColor) end
	syncOutline(); refreshAllColors()
	previewFrame.BackgroundColor3 = CONFIG.OutlineColor
end)

-- Transparency slider
sectionLabel("FILL TRANSPARENCY", 12)
local transHolder = new("Frame", {
	Size = UDim2.new(1, 0, 0, 24),
	BackgroundTransparency = 1,
	LayoutOrder = 13,
}, colorPanel)
local transTrack = new("Frame", {
	Position = UDim2.new(0, 0, 0.5, -6),
	Size = UDim2.new(1, -44, 0, 12),
	BackgroundColor3 = Color3.fromRGB(40, 40, 50),
	BorderSizePixel = 0,
}, transHolder)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, transTrack)
local transFill = new("Frame", {
	Size = UDim2.new(1 - CONFIG.FillTransparency, 0, 1, 0),
	BackgroundColor3 = Color3.fromRGB(180, 180, 200),
	BorderSizePixel = 0,
}, transTrack)
new("UICorner", { CornerRadius = UDim.new(0, 6) }, transFill)
local transKnob = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(1 - CONFIG.FillTransparency, 0, 0.5, 0),
	Size = UDim2.new(0, 16, 0, 16),
	BackgroundColor3 = Color3.fromRGB(240, 240, 245),
	BorderSizePixel = 0,
	ZIndex = 2,
}, transTrack)
new("UICorner", { CornerRadius = UDim.new(1, 0) }, transKnob)
new("UIStroke", { Color = Color3.fromRGB(15, 15, 20), Thickness = 1 }, transKnob)
local transValue = new("TextLabel", {
	Position = UDim2.new(1, -36, 0, 0),
	Size = UDim2.new(0, 36, 1, 0),
	BackgroundTransparency = 1,
	Text = tostring(math.floor((1 - CONFIG.FillTransparency) * 100 + 0.5)) .. "%",
	TextColor3 = Color3.fromRGB(210, 210, 220),
	Font = Enum.Font.Gotham,
	TextSize = 11,
	TextXAlignment = Enum.TextXAlignment.Right,
}, transHolder)

local function updateTransFromX(x)
	local rel = (x - transTrack.AbsolutePosition.X) / transTrack.AbsoluteSize.X
	rel = math.clamp(rel, 0, 1)
	CONFIG.FillTransparency = 1 - rel
	transFill.Size = UDim2.new(rel, 0, 1, 0)
	transKnob.Position = UDim2.new(rel, 0, 0.5, 0)
	transValue.Text = tostring(math.floor(rel * 100 + 0.5)) .. "%"
	refreshAllColors()
	previewInner.BackgroundTransparency = CONFIG.FillTransparency
end

do
	local dragging = false
	transTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateTransFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateTransFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- Reset
local resetBtn = new("TextButton", {
	Size = UDim2.new(1, 0, 0, 30),
	BackgroundColor3 = Color3.fromRGB(60, 25, 25),
	BorderSizePixel = 0,
	Text = "RESET TO DEFAULT",
	TextColor3 = Color3.fromRGB(255, 130, 130),
	Font = Enum.Font.GothamBold,
	TextSize = 11,
	LayoutOrder = 14,
}, colorPanel)
new("UICorner", { CornerRadius = UDim.new(0, 5) }, resetBtn)
new("UIStroke", { Color = Color3.fromRGB(200, 60, 60), Thickness = 1, Transparency = 0.5 }, resetBtn)

resetBtn.MouseButton1Click:Connect(function()
	CONFIG.FillColor           = Color3.fromRGB(255, 0, 0)
	CONFIG.OutlineColor        = Color3.fromRGB(255, 45, 45)
	CONFIG.FillTransparency    = 0.55
	CONFIG.OutlineTransparency = 0
	fillHexBox.Text    = colorToHex(CONFIG.FillColor)
	outlineHexBox.Text = colorToHex(CONFIG.OutlineColor)
	transFill.Size = UDim2.new(1 - CONFIG.FillTransparency, 0, 1, 0)
	transKnob.Position = UDim2.new(1 - CONFIG.FillTransparency, 0, 0.5, 0)
	transValue.Text = tostring(math.floor((1 - CONFIG.FillTransparency) * 100 + 0.5)) .. "%"
	syncFill(); syncOutline()
	refreshAllColors()
	previewFrame.BackgroundColor3 = CONFIG.OutlineColor
	previewInner.BackgroundColor3 = CONFIG.FillColor
	previewInner.BackgroundTransparency = CONFIG.FillTransparency
end)

-- Global sync hook used by presets
_G.__syncColorUI = function()
	syncFill(); syncOutline()
	fillHexBox.Text    = colorToHex(CONFIG.FillColor)
	outlineHexBox.Text = colorToHex(CONFIG.OutlineColor)
	previewFrame.BackgroundColor3 = CONFIG.OutlineColor
	previewInner.BackgroundColor3 = CONFIG.FillColor
	previewInner.BackgroundTransparency = CONFIG.FillTransparency
	refreshAllColors()
end

_G.__syncHex = function()
	fillHexBox.Text    = colorToHex(CONFIG.FillColor)
	outlineHexBox.Text = colorToHex(CONFIG.OutlineColor)
end

syncFill(); syncOutline()

--======================= WORKSPACE TRACKING ==========================
for _, d in ipairs(Workspace:GetDescendants()) do
	if d:IsA("Humanoid") then
		trackedHumanoids[d] = true
	end
end

Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then
		trackedHumanoids[d] = true
		requestScan(0.25)
	elseif d:IsA("LuaSourceContainer") then
		requestScan(0.25)
	end
end)

Workspace.DescendantRemoving:Connect(function(d)
	if d:IsA("Humanoid") then
		trackedHumanoids[d] = nil
	end
end)

--======================= PLAYER TRACKING =============================
local function hookCharacter(plr)
	plr.CharacterAdded:Connect(function()
		requestScan(0.25)
	end)
end

Players.PlayerAdded:Connect(function(plr)
	hookCharacter(plr)
	requestScan(0.25)
end)

Players.PlayerRemoving:Connect(function(plr)
	task.defer(function()
		for model, entry in pairs(activeESP) do
			if entry.player == plr then
				clearESP(model)
			end
		end
	end)
end)

for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LOCAL_PLAYER then
		hookCharacter(plr)
	end
end

--======================== AUTO SCAN LOOP =============================
task.spawn(function()
	while true do
		task.wait(CONFIG.ScanInterval)
		scan()
	end
end)

--========================= INITIAL SCAN ==============================
scan()

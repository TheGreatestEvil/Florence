--===================== ESP STORAGE ===================================
local activeESP        = {}
local trackedHumanoids = {}
local espEnabled       = true

local function clearESP(model)
	local entry = activeESP[model]
	if not entry then return end
	activeESP[model] = nil
	if entry.highlight then entry.highlight:Destroy() end
	if entry.tag       then entry.tag:Destroy() end
end

local function applyESP(model, player, scriptObj, displayName)
	local entry = activeESP[model]

	if entry and entry.highlight and entry.highlight.Parent then
		entry.player = player
		entry.script = scriptObj
		entry.name   = displayName
		return
	end

	clearESP(model)

	local highlight = new("Highlight", {
		Name = "KillerESP_Highlight",
		Adornee = model,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillColor = CONFIG.FillColor,
		OutlineColor = CONFIG.OutlineColor,
		FillTransparency = CONFIG.FillTransparency,
		OutlineTransparency = CONFIG.OutlineTransparency,
	}, gui)

	local tag, tagLabel
	if CONFIG.ShowNameTag then
		local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
		if head then
			tag = new("BillboardGui", {
				Name = "KillerESP_Tag",
				Adornee = head,
				Size = UDim2.new(0, 160, 0, 34),
				StudsOffset = Vector3.new(0, 3, 0),
				AlwaysOnTop = true,
				MaxDistance = 300,
			}, gui)

			tagLabel = new("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "⚠ " .. CONFIG.TagText .. " ⚠",
				TextColor3 = CONFIG.OutlineColor,
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0,
				Font = Enum.Font.GothamBold,
				TextScaled = true,
			}, tag)
		end
	end

	activeESP[model] = {
		highlight = highlight,
		tag       = tag,
		tagLabel  = tagLabel,
		player    = player,
		script    = scriptObj,
		name      = displayName,
	}
end

--============= GLOBAL COLOR REFRESH ==================================
local function refreshAllColors()
	for _, entry in pairs(activeESP) do
		if entry.highlight then
			entry.highlight.FillColor    = CONFIG.FillColor
			entry.highlight.OutlineColor = CONFIG.OutlineColor
			entry.highlight.FillTransparency    = CONFIG.FillTransparency
			entry.highlight.OutlineTransparency = CONFIG.OutlineTransparency
		end
		if entry.tagLabel then
			entry.tagLabel.TextColor3 = CONFIG.OutlineColor
		end
	end
end

--======================= SCRIPT DETECTION ============================
local KEYWORD = string.lower(CONFIG.Keyword)

local function isKillerScript(inst)
	if not inst:IsA("LuaSourceContainer") then return false end
	return string.sub(string.lower(inst.Name), 1, #KEYWORD) == KEYWORD
end

local function findKillerScript(container)
	for _, d in ipairs(container:GetDescendants()) do
		if isKillerScript(d) then
			return d
		end
	end
	return nil
end

local function getPlayerContainers(plr)
	local list = {}
	local function add(o)
		if o then table.insert(list, o) end
	end
	add(plr.Character)
	add(plr:FindFirstChildOfClass("Backpack"))
	add(plr:FindFirstChildOfClass("PlayerGui"))
	add(plr:FindFirstChild("PlayerScripts"))
	add(plr:FindFirstChild("StarterGear"))
	return list
end

--=========================== GUI LIST ================================
local function updateList(results)
	for _, c in ipairs(listPanel:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end

	local count = 0
	for _, data in pairs(results) do
		count += 1
		local row = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = Color3.fromRGB(48, 20, 20),
			BorderSizePixel = 0,
			Text = "  " .. data.name .. "  →  " .. data.script.Name,
			TextColor3 = Color3.fromRGB(255, 115, 115),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = count,
		}, listPanel)
		new("UICorner", { CornerRadius = UDim.new(0, 5) }, row)
	end

	if count == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "  No killers detected",
			TextColor3 = Color3.fromRGB(130, 130, 140),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
		}, listPanel)
	end

	return count
end

--============================= SCAN ==================================
local function scan()
	local results      = {}
	local totalChecked = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if not (CONFIG.IgnoreLocalPlayer and plr == LOCAL_PLAYER) then
			local char = plr.Character
			local hum  = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum then
				totalChecked += 1
				local found
				for _, container in ipairs(getPlayerContainers(plr)) do
					found = findKillerScript(container)
					if found then break end
				end
				if found then
					results[char] = { player = plr, script = found, name = plr.Name }
				end
			end
		end
	end

	for hum in pairs(trackedHumanoids) do
		if hum.Parent == nil then
			trackedHumanoids[hum] = nil
		else
			local model = hum.Parent
			if model and not results[model] then
				if not Players:GetPlayerFromCharacter(model) then
					totalChecked += 1
					local found = findKillerScript(model)
					if found then
						results[model] = { player = nil, script = found, name = model.Name }
					end
				end
			end
		end
	end

	if espEnabled then
		for model, data in pairs(results) do
			applyESP(model, data.player, data.script, data.name)
		end
	end

	for model in pairs(activeESP) do
		if not espEnabled or not results[model] or not model.Parent then
			clearESP(model)
		end
	end

	local count = updateList(results)
	if espEnabled then
		statusLabel.Text = ("Active  •  %d flagged  •  %d scanned"):format(count, totalChecked)
	else
		statusLabel.Text = ("ESP OFF  •  %d flagged"):format(count)
	end

	return results
end

--========================== DEBOUNCED SCAN ===========================
local scanQueued = false
local function requestScan(delay)
	if scanQueued then return end
	scanQueued = true
	task.delay(delay or 0.35, function()
		scanQueued = false
		scan()
	end)
end

--=========================== BUTTONS =================================

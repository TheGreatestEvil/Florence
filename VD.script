--==================== MINIMIZE / CLOSE BEHAVIOR ======================
local minimized = false

local function setMinimized(state)
	minimized = state
	if minimized then
		main.Size = MINI_SIZE
		main.Position = UDim2.new(
			main.Position.X.Scale, main.Position.X.Offset,
			main.Position.Y.Scale, main.Position.Y.Offset
		)
		minBtn.Text = "+"
	else
		main.Size = FULL_SIZE
		minBtn.Text = "–"
	end

	-- hide everything except the title bar
	statusLabel.Visible = not minimized
	btnRow.Visible      = not minimized
	tabBar.Visible      = not minimized
	panelArea.Visible   = not minimized
end

minBtn.MouseButton1Click:Connect(function()
	setMinimized(not minimized)
end)

-- Close = hide the whole window and show the reopen pill
closeBtn.MouseButton1Click:Connect(function()
	main.Visible = false
	reopenBtn.Visible = true
end)

-- Extra: keyboard toggle (default RightControl) hides/shows window
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == CONFIG.ToggleKey then
		if main.Visible then
			main.Visible = false
			reopenBtn.Visible = true
		else
			main.Visible = true
			reopenBtn.Visible = false
		end
	end
end)

--========================== DRAGGABLE WINDOW =========================
do
	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end


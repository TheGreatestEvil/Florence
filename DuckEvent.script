local function createEntry(model, index)
	local row = new("Frame", {
		Name = model.Name,
		Size = UDim2.new(1, -4, 0, 26),
		BackgroundColor3 = Color3.fromRGB(38, 38, 47),
		BorderSizePixel = 0,
		LayoutOrder = index,
	}, scroll)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, row)

	new("TextLabel", {
		Name = "ModelName",
		Position = UDim2.new(0, 6, 0, 0),
		Size = UDim2.new(1, -56, 1, 0),
		BackgroundTransparency = 1,
		Text = model.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(220, 220, 232),
	}, row)

	local tpButton = new("TextButton", {
		Name = "Tp",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.new(0, 42, 0, 18),
		BackgroundColor3 = Color3.fromRGB(58, 128, 220),
		BorderSizePixel = 0,
		Text = "Tp",
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		AutoButtonColor = true,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, tpButton)

	tpButton.MouseButton1Click:Connect(function()
		teleportToModel(model)
		status.Text = "Teleported → " .. model.Name
	end)
end

local scanning = false
local function scan()
	if scanning then return end
	scanning = true
	clearList()

	local container = Workspace:FindFirstChild(CONFIG.ContainerName)
	if not container then
		status.Text = "❌ " .. CONFIG.ContainerName .. " not found"
		scanning = false
		return
	end
	local folder = container:FindFirstChild(CONFIG.FolderName)
	if not folder then
		status.Text = "❌ " .. CONFIG.FolderName .. " not found"
		scanning = false
		return
	end

	local count = 0
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			count += 1
			createEntry(model, count)
		end
	end
	status.Text = ("Found %d model%s"):format(count, count == 1 and "" or "s")
	scanning = false
end

refreshBtn.MouseButton1Click:Connect(scan)

if CONFIG.AutoRefresh then
	task.spawn(function()
		local container = Workspace:WaitForChild(CONFIG.ContainerName, 30)
		if not container then return end
		local folder = container:WaitForChild(CONFIG.FolderName, 30)
		if not folder then return end
		local function queueScan() task.defer(scan) end
		folder.ChildAdded:Connect(queueScan)
		folder.ChildRemoved:Connect(queueScan)
	end)
end


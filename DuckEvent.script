-- Fly state table --------------------------------------------------
local flyState = {
	active = false,
	speed = CONFIG.FlyDefSpeed,
	connection = nil,
	bodyVelocity = nil,
	savedWalkSpeed = nil,
	upHeld = false,
	downHeld = false,
}

-- Fly logic --------------------------------------------------------
local function stopFly()
	flyState.active = false

	if flyState.connection then
		flyState.connection:Disconnect()
		flyState.connection = nil
	end
	if flyState.bodyVelocity then
		flyState.bodyVelocity:Destroy()
		flyState.bodyVelocity = nil
	end

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			if flyState.savedWalkSpeed then
				hum.WalkSpeed = flyState.savedWalkSpeed
			end
			pcall(function() hum:Move(Vector3.new(), true) end)
		end
	end
	flyState.savedWalkSpeed = nil
end

local function startFly()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	flyState.active = true
	flyState.savedWalkSpeed = hum.WalkSpeed
	hum.WalkSpeed = 0

	local bv = Instance.new("BodyVelocity")
	bv.Name = "FlyVelocity"
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Velocity = Vector3.zero
	bv.Parent = hrp
	flyState.bodyVelocity = bv

	flyState.connection = RunService.RenderStepped:Connect(function()
		if not hrp.Parent or not hum.Parent then
			stopFly()
			flyToggleBtn.Text = "Fly: OFF"
			flyToggleBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
			miscStatus.Text = "Fly disabled"
			return
		end

		local moveDir = Vector3.zero

		-- Horizontal from humanoid input (covers WASD + mobile joystick)
		local hDir = hum.MoveDirection
		if hDir.Magnitude > 0 then
			moveDir += hDir
		end

		-- Vertical
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or flyState.upHeld then
			moveDir += Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or flyState.downHeld then
			moveDir -= Vector3.new(0, 1, 0)
		end

		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit
		end

		bv.Velocity = moveDir * flyState.speed
	end)
end

local function setFly(active)
	if active then
		startFly()
		flyToggleBtn.Text = "Fly: ON"
		flyToggleBtn.BackgroundColor3 = Color3.fromRGB(58, 128, 220)
		miscStatus.Text = "Flying at speed " .. flyState.speed
	else
		stopFly()
		flyToggleBtn.Text = "Fly: OFF"
		flyToggleBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
		miscStatus.Text = "Fly disabled"
	end
end

flyToggleBtn.MouseButton1Click:Connect(function()
	setFly(not flyState.active)
end)

-- Stop fly on respawn (avoid stale references) --------------------
player.CharacterAdded:Connect(function()
	if flyState.active then
		task.wait(0.1)
		stopFly()
		flyToggleBtn.Text = "Fly: OFF"
		flyToggleBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
		miscStatus.Text = "Fly disabled"
	end
end)

--=============== SLIDER LOGIC (mouse + touch) =====================
do
	local dragging = false

	local function valueFromAlpha(alpha)
		return math.floor(
			CONFIG.FlyMinSpeed + (CONFIG.FlyMaxSpeed - CONFIG.FlyMinSpeed) * alpha + 0.5
		)
	end

	local function updateFromX(xPos)
		local trackX = sliderTrack.AbsolutePosition.X
		local trackW = sliderTrack.AbsoluteSize.X
		if trackW <= 0 then return end
		local alpha = math.clamp((xPos - trackX) / trackW, 0, 1)

		sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
		sliderKnob.Position = UDim2.new(alpha, 0, 0.5, 0)

		local val = valueFromAlpha(alpha)
		flyState.speed = val
		speedLabel.Text = "Speed: " .. val
		if flyState.active then
			miscStatus.Text = "Flying at speed " .. val
		end
	end

	-- Initialize slider position to default speed
	local initAlpha = (CONFIG.FlyDefSpeed - CONFIG.FlyMinSpeed)
		/ (CONFIG.FlyMaxSpeed - CONFIG.FlyMinSpeed)
	sliderFill.Size = UDim2.new(initAlpha, 0, 1, 0)
	sliderKnob.Position = UDim2.new(initAlpha, 0, 0.5, 0)

	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

--=============== UP/DOWN HOLD BUTTONS (mobile) ====================
do
	local upBtn = new("TextButton", {
		Name = "UpBtn",
		Position = UDim2.new(0, 8, 0, 120),
		Size = UDim2.new(0.5, -12, 0, 30),
		BackgroundColor3 = Color3.fromRGB(55, 55, 68),
		BorderSizePixel = 0,
		Text = "⬆ Up",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(230, 230, 240),
		AutoButtonColor = true,
	}, miscPage)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, upBtn)

	local downBtn = new("TextButton", {
		Name = "DownBtn",
		Position = UDim2.new(0.5, 4, 0, 120),
		Size = UDim2.new(0.5, -12, 0, 30),
		BackgroundColor3 = Color3.fromRGB(55, 55, 68),
		BorderSizePixel = 0,
		Text = "⬇ Down",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(230, 230, 240),
		AutoButtonColor = true,
	}, miscPage)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, downBtn)

	local upInput, downInput

	upBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			flyState.upHeld = true
			upInput = input
		end
	end)
	upBtn.InputEnded:Connect(function(input)
		if input == upInput then
			flyState.upHeld = false
			upInput = nil
		end
	end)

	downBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			flyState.downHeld = true
			downInput = input
		end
	end)
	downBtn.InputEnded:Connect(function(input)
		if input == downInput then
			flyState.downHeld = false
			downInput = nil
		end
	end)

	-- Failsafe: if the input ends anywhere on screen
	UserInputService.InputEnded:Connect(function(input)
		if input == upInput then
			flyState.upHeld = false
			upInput = nil
		end
		if input == downInput then
			flyState.downHeld = false
			downInput = nil
		end
	end)
end

--===================== DRAG THE MAIN WINDOW =======================
do
	local dragging, dragStart, startPos

	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end

	header.InputBegan:Connect(beginDrag)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end)
end

--===================== MINIMIZE TOGGLE ============================
do
	local minimized = false
	local fullSize = CONFIG.WindowSize

	minimizeBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			main.Size = UDim2.new(0, 200, 0, 26)
			tabBar.Visible = false
			content.Visible = false
			minimizeBtn.Text = "+"
		else
			main.Size = fullSize
			tabBar.Visible = true
			content.Visible = true
			minimizeBtn.Text = "–"
		end
	end)
end

--==================================================================
--  FLOATING TOGGLE BUTTON (draggable on PC + mobile)
--==================================================================
local floating = new("TextButton", {
	Name = "FloatingToggle",
	Position = CONFIG.FloatingPos,
	Size = CONFIG.FloatingSize,
	BackgroundColor3 = Color3.fromRGB(58, 128, 220),
	BorderSizePixel = 0,
	Text = "🔍",
	Font = Enum.Font.GothamBold,
	TextSize = 22,
	TextColor3 = Color3.fromRGB(255, 255, 255),
	AutoButtonColor = false,
	Active = true,
	ZIndex = 5,
}, screenGui)
new("UICorner", { CornerRadius = UDim.new(1, 0) }, floating)
new("UIStroke", { Color = Color3.fromRGB(90, 90, 105), Thickness = 1 }, floating)

do
	local dragging     = false
	local dragStart    = nil
	local startPos     = nil
	local moved        = false
	local pressBegan   = 0

	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging    = true
		moved       = false
		pressBegan  = os.clock()
		dragStart   = input.Position
		startPos    = floating.Position
		floating.BackgroundColor3 = Color3.fromRGB(72, 148, 240)
	end

	local function endDrag()
		if not dragging then return end
		dragging = false
		floating.BackgroundColor3 = Color3.fromRGB(58, 128, 220)
		if not moved and (os.clock() - pressBegan) < 0.6 then
			main.Visible = not main.Visible
		end
	end

	floating.InputBegan:Connect(beginDrag)
	floating.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			endDrag()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		if math.abs(delta.X) > CONFIG.DragThreshold
			or math.abs(delta.Y) > CONFIG.DragThreshold then
			moved = true
		end
		floating.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			endDrag()
		end
	end)
end

--========================= RUN ====================================
showTab("Ducks")
scan()
refreshPlayerList()

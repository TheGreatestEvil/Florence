	CanvasSize = UDim2.new(0, 0, 0, 0),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, playersPage)
new("UIListLayout", {
	Padding = UDim.new(0, 4),
	SortOrder = Enum.SortOrder.LayoutOrder,
}, playerScroll)

local function clearPlayerList()
	for _, child in ipairs(playerScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
end

local function refreshPlayerList()
	clearPlayerList()
	local list = Players:GetPlayers()
	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for i, plr in ipairs(list) do
		local isMe = (plr == player)
		local nameBtn = new("TextButton", {
			Name = plr.Name,
			Size = UDim2.new(1, -4, 0, 24),
			BackgroundColor3 = isMe
				and Color3.fromRGB(60, 90, 140)
				or Color3.fromRGB(38, 38, 47),
			BorderSizePixel = 0,
			Text = isMe and (plr.Name .. " (You)") or plr.Name,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = Color3.fromRGB(220, 220, 232),
			AutoButtonColor = true,
			LayoutOrder = i,
		}, playerScroll)
		new("UICorner", { CornerRadius = UDim.new(0, 5) }, nameBtn)
		new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, nameBtn)

		nameBtn.MouseButton1Click:Connect(function()
			local target = Players:FindFirstChild(nameBtn.Name)
			if not target then
				playerStatus.Text = "❌ Player left the game"
				refreshPlayerList()
				return
			end
			if target == player then
				playerStatus.Text = "That's you!"
				return
			end
			local ok, err = teleportToPlayer(target)
			if ok then
				playerStatus.Text = "Teleported → " .. target.Name
			else
				playerStatus.Text = "❌ " .. (err or "Failed")
			end
		end)
	end
	local count = #list
	playerStatus.Text = ("%d player%s"):format(count, count == 1 and "" or "s")
end

playerRefreshBtn.MouseButton1Click:Connect(refreshPlayerList)
Players.PlayerAdded:Connect(function() task.defer(refreshPlayerList) end)
Players.PlayerRemoving:Connect(function() task.defer(refreshPlayerList) end)

local function watchCharacter(plr)
	plr.CharacterAdded:Connect(function()
		task.defer(refreshPlayerList)
	end)
end
for _, plr in ipairs(Players:GetPlayers()) do watchCharacter(plr) end
Players.PlayerAdded:Connect(watchCharacter)

